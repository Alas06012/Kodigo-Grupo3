<?xml version="1.0" ?>
<workflow>
  <name>wf_02_dimensiones</name>
  <name_sync_with_filename>Y</name_sync_with_filename>
  <description>Orquestador de carga de Dimensiones SCD1 y SCD2 con Tiempo</description>
  <extended_description/>
  <workflow_version/>
  <created_user>-</created_user>
  <created_date>2026/10/22 14:45:00.000</created_date>
  <modified_user>-</modified_user>
  <modified_date>2026/10/22 14:45:00.000</modified_date>
  <parameters>
    <parameter>
      <name>TIPO_CARGA</name>
      <default_value>INCREMENTAL</default_value>
      <description>Tipo de carga: FULL o INCREMENTAL</description>
    </parameter>
    <parameter>
      <name>BATCH_ID</name>
      <default_value/>
      <description>Identificador único de lote</description>
    </parameter>
  </parameters>
  <actions>
    <action>
      <name>Start</name>
      <type>SPECIAL</type>
      <start>Y</start>
      <dummy>N</dummy>
      <repeat>N</repeat>
      <schedulerType>0</schedulerType>
      <parallel>N</parallel>
      <xloc>60</xloc>
      <yloc>100</yloc>
    </action>
    <action>
      <name>Carga DIM_TIEMPO</name>
      <type>SQL</type>
      <sql>BEGIN dwh_clinica_user.SP_LOAD_DIM_TIEMPO(2019, 2030, '${BATCH_ID}'); END;</sql>
      <useVariableSubstitution>Y</useVariableSubstitution>
      <sqlfromfile>N</sqlfromfile>
      <sendOneStatement>Y</sendOneStatement>
      <connection>Oracle_RedClinicas_DWH</connection>
      <parallel>N</parallel>
      <xloc>220</xloc>
      <yloc>100</yloc>
    </action>
    <action>
      <name>Carga DIM_UBICACION</name>
      <type>SQL</type>
      <sql>BEGIN dwh_clinica_user.SP_LOAD_DIM_UBICACION('${TIPO_CARGA}', '${BATCH_ID}'); END;</sql>
      <useVariableSubstitution>Y</useVariableSubstitution>
      <sqlfromfile>N</sqlfromfile>
      <sendOneStatement>Y</sendOneStatement>
      <connection>Oracle_RedClinicas_DWH</connection>
      <parallel>N</parallel>
      <xloc>420</xloc>
      <yloc>100</yloc>
    </action>
    <action>
      <name>Carga DIM_ESPECIALIDAD</name>
      <type>SQL</type>
      <sql>BEGIN dwh_clinica_user.SP_LOAD_DIM_ESPECIALIDAD('${TIPO_CARGA}', '${BATCH_ID}'); END;</sql>
      <useVariableSubstitution>Y</useVariableSubstitution>
      <sqlfromfile>N</sqlfromfile>
      <sendOneStatement>Y</sendOneStatement>
      <connection>Oracle_RedClinicas_DWH</connection>
      <parallel>N</parallel>
      <xloc>620</xloc>
      <yloc>100</yloc>
    </action>
    <action>
      <name>Carga DIM_ENFERMEDAD</name>
      <type>SQL</type>
      <sql>BEGIN dwh_clinica_user.SP_LOAD_DIM_ENFERMEDAD('${TIPO_CARGA}', '${BATCH_ID}'); END;</sql>
      <useVariableSubstitution>Y</useVariableSubstitution>
      <sqlfromfile>N</sqlfromfile>
      <sendOneStatement>Y</sendOneStatement>
      <connection>Oracle_RedClinicas_DWH</connection>
      <parallel>N</parallel>
      <xloc>820</xloc>
      <yloc>100</yloc>
    </action>
    <action>
      <name>Carga DIM_TIPO_CONSULTA</name>
      <type>SQL</type>
      <sql>BEGIN dwh_clinica_user.SP_LOAD_DIM_TIPO_CONSULTA('${TIPO_CARGA}', '${BATCH_ID}'); END;</sql>
      <useVariableSubstitution>Y</useVariableSubstitution>
      <sqlfromfile>N</sqlfromfile>
      <sendOneStatement>Y</sendOneStatement>
      <connection>Oracle_RedClinicas_DWH</connection>
      <parallel>N</parallel>
      <xloc>1020</xloc>
      <yloc>100</yloc>
    </action>
    <action>
      <name>Carga DIM_FORMA_PAGO</name>
      <type>SQL</type>
      <sql>BEGIN dwh_clinica_user.SP_LOAD_DIM_FORMA_PAGO('${TIPO_CARGA}', '${BATCH_ID}'); END;</sql>
      <useVariableSubstitution>Y</useVariableSubstitution>
      <sqlfromfile>N</sqlfromfile>
      <sendOneStatement>Y</sendOneStatement>
      <connection>Oracle_RedClinicas_DWH</connection>
      <parallel>N</parallel>
      <xloc>220</xloc>
      <yloc>240</yloc>
    </action>
    <action>
      <name>Carga DIM_PAGADOR</name>
      <type>SQL</type>
      <sql>BEGIN dwh_clinica_user.SP_LOAD_DIM_PAGADOR('${TIPO_CARGA}', '${BATCH_ID}'); END;</sql>
      <useVariableSubstitution>Y</useVariableSubstitution>
      <sqlfromfile>N</sqlfromfile>
      <sendOneStatement>Y</sendOneStatement>
      <connection>Oracle_RedClinicas_DWH</connection>
      <parallel>N</parallel>
      <xloc>420</xloc>
      <yloc>240</yloc>
    </action>
    <action>
      <name>Carga DIM_CLINICA (SCD2)</name>
      <type>SQL</type>
      <sql>BEGIN dwh_clinica_user.SP_LOAD_DIM_CLINICA('${TIPO_CARGA}', '${BATCH_ID}'); END;</sql>
      <useVariableSubstitution>Y</useVariableSubstitution>
      <sqlfromfile>N</sqlfromfile>
      <sendOneStatement>Y</sendOneStatement>
      <connection>Oracle_RedClinicas_DWH</connection>
      <parallel>N</parallel>
      <xloc>620</xloc>
      <yloc>240</yloc>
    </action>
    <action>
      <name>Carga DIM_MEDICO (SCD2)</name>
      <type>SQL</type>
      <sql>BEGIN dwh_clinica_user.SP_LOAD_DIM_MEDICO('${TIPO_CARGA}', '${BATCH_ID}'); END;</sql>
      <useVariableSubstitution>Y</useVariableSubstitution>
      <sqlfromfile>N</sqlfromfile>
      <sendOneStatement>Y</sendOneStatement>
      <connection>Oracle_RedClinicas_DWH</connection>
      <parallel>N</parallel>
      <xloc>820</xloc>
      <yloc>240</yloc>
    </action>
    <action>
      <name>Carga DIM_PACIENTE (SCD2)</name>
      <type>SQL</type>
      <sql>BEGIN dwh_clinica_user.SP_LOAD_DIM_PACIENTE('${TIPO_CARGA}', '${BATCH_ID}'); END;</sql>
      <useVariableSubstitution>Y</useVariableSubstitution>
      <sqlfromfile>N</sqlfromfile>
      <sendOneStatement>Y</sendOneStatement>
      <connection>Oracle_RedClinicas_DWH</connection>
      <parallel>N</parallel>
      <xloc>1020</xloc>
      <yloc>240</yloc>
    </action>
    <action>
      <name>Dimensiones Finalizadas</name>
      <type>SUCCESS</type>
      <parallel>N</parallel>
      <xloc>220</xloc>
      <yloc>380</yloc>
    </action>
  </actions>
  <hops>
    <hop>
      <from>Start</from>
      <to>Carga DIM_TIEMPO</to>
      <enabled>Y</enabled>
      <evaluation>Y</evaluation>
      <unconditional>Y</unconditional>
    </hop>
    <hop>
      <from>Carga DIM_TIEMPO</from>
      <to>Carga DIM_UBICACION</to>
      <enabled>Y</enabled>
      <evaluation>Y</evaluation>
      <unconditional>N</unconditional>
    </hop>
    <hop>
      <from>Carga DIM_UBICACION</from>
      <to>Carga DIM_ESPECIALIDAD</to>
      <enabled>Y</enabled>
      <evaluation>Y</evaluation>
      <unconditional>N</unconditional>
    </hop>
    <hop>
      <from>Carga DIM_ESPECIALIDAD</from>
      <to>Carga DIM_ENFERMEDAD</to>
      <enabled>Y</enabled>
      <evaluation>Y</evaluation>
      <unconditional>N</unconditional>
    </hop>
    <hop>
      <from>Carga DIM_ENFERMEDAD</from>
      <to>Carga DIM_TIPO_CONSULTA</to>
      <enabled>Y</enabled>
      <evaluation>Y</evaluation>
      <unconditional>N</unconditional>
    </hop>
    <hop>
      <from>Carga DIM_TIPO_CONSULTA</from>
      <to>Carga DIM_FORMA_PAGO</to>
      <enabled>Y</enabled>
      <evaluation>Y</evaluation>
      <unconditional>N</unconditional>
    </hop>
    <hop>
      <from>Carga DIM_FORMA_PAGO</from>
      <to>Carga DIM_PAGADOR</to>
      <enabled>Y</enabled>
      <evaluation>Y</evaluation>
      <unconditional>N</unconditional>
    </hop>
    <hop>
      <from>Carga DIM_PAGADOR</from>
      <to>Carga DIM_CLINICA (SCD2)</to>
      <enabled>Y</enabled>
      <evaluation>Y</evaluation>
      <unconditional>N</unconditional>
    </hop>
    <hop>
      <from>Carga DIM_CLINICA (SCD2)</from>
      <to>Carga DIM_MEDICO (SCD2)</to>
      <enabled>Y</enabled>
      <evaluation>Y</evaluation>
      <unconditional>N</unconditional>
    </hop>
    <hop>
      <from>Carga DIM_MEDICO (SCD2)</from>
      <to>Carga DIM_PACIENTE (SCD2)</to>
      <enabled>Y</enabled>
      <evaluation>Y</evaluation>
      <unconditional>N</unconditional>
    </hop>
    <hop>
      <from>Carga DIM_PACIENTE (SCD2)</from>
      <to>Dimensiones Finalizadas</to>
      <enabled>Y</enabled>
      <evaluation>Y</evaluation>
      <unconditional>N</unconditional>
    </hop>
  </hops>
  <notepads/>
</workflow>
