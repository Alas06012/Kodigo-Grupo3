<?xml version="1.0" ?>
<workflow>
  <name>wf_dwh_master</name>
  <name_sync_with_filename>Y</name_sync_with_filename>
  <description>Orquestador Maestro End-to-End: Staging -&gt; Dimensiones -&gt; Hechos -&gt; Control Auditoría</description>
  <extended_description/>
  <workflow_version/>
  <created_user>-</created_user>
  <created_date>2026/10/22 14:45:00.000</created_date>
  <modified_user>-</modified_user>
  <modified_date>2026/10/22 14:45:00.000</modified_date>
  <parameters>
    <parameter>
      <name>TIPO_CARGA</name>
      <default_value>INCREMENTAL</default_value>
      <description>Tipo de carga analítica: FULL o INCREMENTAL</description>
    </parameter>
    <parameter>
      <name>DIAS_LOOKBACK</name>
      <default_value>3</default_value>
      <description>Ventana de días para retroceso incremental</description>
    </parameter>
    <parameter>
      <name>FECHA_CORTE</name>
      <default_value/>
      <description>Fecha de corte específica (opcional, YYYY-MM-DD)</description>
    </parameter>
    <parameter>
      <name>BATCH_ID</name>
      <default_value/>
      <description>Identificador único de lote (si se deja vacío, Hop asigna BATCH_TIMESTAMP)</description>
    </parameter>
  </parameters>
  <actions>
    <action>
      <name>Start</name>
      <type>SPECIAL</type>
      <start>Y</start>
      <dummy>N</dummy>
      <repeat>N</repeat>
      <schedulerType>0</schedulerType>
      <parallel>N</parallel>
      <xloc>60</xloc>
      <yloc>140</yloc>
    </action>
    <action>
      <name>Registrar Inicio y Batch ID</name>
      <type>EVAL</type>
      <script>var b = parent_workflow.getVariable('BATCH_ID');
if (b == null || b == '' || b.indexOf('BATCH_ID') &gt;= 0) {
  var sdf = new java.text.SimpleDateFormat('yyyyMMdd_HHmmss');
  b = 'BATCH_' + sdf.format(new java.util.Date());
  parent_workflow.setVariable('BATCH_ID', b);
}
true;</script>
      <parallel>N</parallel>
      <xloc>220</xloc>
      <yloc>140</yloc>
    </action>
    <action>
      <name>Sub-Workflow: Ingesta Staging</name>
      <type>WORKFLOW</type>
      <run_configuration>local</run_configuration>
      <filename>${PROJECT_HOME}/wf_01_staging.hwf</filename>
      <params_from_previous>N</params_from_previous>
      <exec_per_row>N</exec_per_row>
      <set_logfile>N</set_logfile>
      <logfile/>
      <logext/>
      <add_date>N</add_date>
      <add_time>N</add_time>
      <loglevel>Basic</loglevel>
      <wait_until_finished>Y</wait_until_finished>
      <create_parent_folder>N</create_parent_folder>
      <run_multiple>N</run_multiple>
      <parameters>
        <parameter>
          <name>TIPO_CARGA</name>
          <stream_name/>
          <value>${TIPO_CARGA}</value>
        </parameter>
        <parameter>
          <name>DIAS_LOOKBACK</name>
          <stream_name/>
          <value>${DIAS_LOOKBACK}</value>
        </parameter>
        <parameter>
          <name>FECHA_CORTE</name>
          <stream_name/>
          <value>${FECHA_CORTE}</value>
        </parameter>
        <parameter>
          <name>BATCH_ID</name>
          <stream_name/>
          <value>${BATCH_ID}</value>
        </parameter>
        <pass_all_parameters>Y</pass_all_parameters>
      </parameters>
      <parallel>N</parallel>
      <xloc>420</xloc>
      <yloc>140</yloc>
    </action>
    <action>
      <name>Sub-Workflow: Carga Dimensiones</name>
      <type>WORKFLOW</type>
      <run_configuration>local</run_configuration>
      <filename>${PROJECT_HOME}/wf_02_dimensiones.hwf</filename>
      <params_from_previous>N</params_from_previous>
      <exec_per_row>N</exec_per_row>
      <set_logfile>N</set_logfile>
      <logfile/>
      <logext/>
      <add_date>N</add_date>
      <add_time>N</add_time>
      <loglevel>Basic</loglevel>
      <wait_until_finished>Y</wait_until_finished>
      <create_parent_folder>N</create_parent_folder>
      <run_multiple>N</run_multiple>
      <parameters>
        <parameter>
          <name>TIPO_CARGA</name>
          <stream_name/>
          <value>${TIPO_CARGA}</value>
        </parameter>
        <parameter>
          <name>DIAS_LOOKBACK</name>
          <stream_name/>
          <value>${DIAS_LOOKBACK}</value>
        </parameter>
        <parameter>
          <name>FECHA_CORTE</name>
          <stream_name/>
          <value>${FECHA_CORTE}</value>
        </parameter>
        <parameter>
          <name>BATCH_ID</name>
          <stream_name/>
          <value>${BATCH_ID}</value>
        </parameter>
        <pass_all_parameters>Y</pass_all_parameters>
      </parameters>
      <parallel>N</parallel>
      <xloc>640</xloc>
      <yloc>140</yloc>
    </action>
    <action>
      <name>Sub-Workflow: Carga Hechos</name>
      <type>WORKFLOW</type>
      <run_configuration>local</run_configuration>
      <filename>${PROJECT_HOME}/wf_03_hechos.hwf</filename>
      <params_from_previous>N</params_from_previous>
      <exec_per_row>N</exec_per_row>
      <set_logfile>N</set_logfile>
      <logfile/>
      <logext/>
      <add_date>N</add_date>
      <add_time>N</add_time>
      <loglevel>Basic</loglevel>
      <wait_until_finished>Y</wait_until_finished>
      <create_parent_folder>N</create_parent_folder>
      <run_multiple>N</run_multiple>
      <parameters>
        <parameter>
          <name>TIPO_CARGA</name>
          <stream_name/>
          <value>${TIPO_CARGA}</value>
        </parameter>
        <parameter>
          <name>DIAS_LOOKBACK</name>
          <stream_name/>
          <value>${DIAS_LOOKBACK}</value>
        </parameter>
        <parameter>
          <name>FECHA_CORTE</name>
          <stream_name/>
          <value>${FECHA_CORTE}</value>
        </parameter>
        <parameter>
          <name>BATCH_ID</name>
          <stream_name/>
          <value>${BATCH_ID}</value>
        </parameter>
        <pass_all_parameters>Y</pass_all_parameters>
      </parameters>
      <parallel>N</parallel>
      <xloc>860</xloc>
      <yloc>140</yloc>
    </action>
    <action>
      <name>Verificar Control de Auditoria</name>
      <type>SQL</type>
      <sql>DECLARE
    v_fallos NUMBER;
    v_batch  VARCHAR2(50) := '';
BEGIN
    SELECT COUNT(*) INTO v_fallos
    FROM dwh_clinica_user.CTL_ETL_AUDIT
    WHERE BATCH_ID = v_batch
      AND ESTADO = 'FAILED';
    IF v_fallos &gt; 0 THEN
        RAISE_APPLICATION_ERROR(-20020, 'ALERTA: Se detectaron ' || v_fallos || ' fallos en CTL_ETL_AUDIT para el lote ' || v_batch);
    END IF;
END;</sql>
      <useVariableSubstitution>Y</useVariableSubstitution>
      <sqlfromfile>N</sqlfromfile>
      <sendOneStatement>Y</sendOneStatement>
      <connection>Oracle_RedClinicas_DWH</connection>
      <parallel>N</parallel>
      <xloc>1080</xloc>
      <yloc>140</yloc>
    </action>
    <action>
      <name>Pipeline DWH Exitoso</name>
      <type>SUCCESS</type>
      <parallel>N</parallel>
      <xloc>1280</xloc>
      <yloc>140</yloc>
    </action>
  </actions>
  <hops>
    <hop>
      <from>Start</from>
      <to>Registrar Inicio y Batch ID</to>
      <enabled>Y</enabled>
      <evaluation>Y</evaluation>
      <unconditional>Y</unconditional>
    </hop>
    <hop>
      <from>Registrar Inicio y Batch ID</from>
      <to>Sub-Workflow: Ingesta Staging</to>
      <enabled>Y</enabled>
      <evaluation>Y</evaluation>
      <unconditional>N</unconditional>
    </hop>
    <hop>
      <from>Sub-Workflow: Ingesta Staging</from>
      <to>Sub-Workflow: Carga Dimensiones</to>
      <enabled>Y</enabled>
      <evaluation>Y</evaluation>
      <unconditional>N</unconditional>
    </hop>
    <hop>
      <from>Sub-Workflow: Carga Dimensiones</from>
      <to>Sub-Workflow: Carga Hechos</to>
      <enabled>Y</enabled>
      <evaluation>Y</evaluation>
      <unconditional>N</unconditional>
    </hop>
    <hop>
      <from>Sub-Workflow: Carga Hechos</from>
      <to>Verificar Control de Auditoria</to>
      <enabled>Y</enabled>
      <evaluation>Y</evaluation>
      <unconditional>N</unconditional>
    </hop>
    <hop>
      <from>Verificar Control de Auditoria</from>
      <to>Pipeline DWH Exitoso</to>
      <enabled>Y</enabled>
      <evaluation>Y</evaluation>
      <unconditional>N</unconditional>
    </hop>
  </hops>
  <notepads/>
</workflow>
