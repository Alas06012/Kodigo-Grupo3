<?xml version="1.0" ?>
<workflow>
  <name>wf_01_staging</name>
  <name_sync_with_filename>Y</name_sync_with_filename>
  <description>Orquestador de extracción OLTP hacia STAGING con auditoría nativa</description>
  <extended_description/>
  <workflow_version/>
  <created_user>-</created_user>
  <created_date>2026/10/22 14:45:00.000</created_date>
  <modified_user>-</modified_user>
  <modified_date>2026/10/22 14:45:00.000</modified_date>
  <parameters>
    <parameter>
      <name>TIPO_CARGA</name>
      <default_value>INCREMENTAL</default_value>
      <description>Tipo de carga: FULL o INCREMENTAL</description>
    </parameter>
    <parameter>
      <name>DIAS_LOOKBACK</name>
      <default_value>3</default_value>
      <description>Días de retroceso (ventana lookback)</description>
    </parameter>
    <parameter>
      <name>FECHA_CORTE</name>
      <default_value/>
      <description>Fecha de corte específica (opcional, formato YYYY-MM-DD)</description>
    </parameter>
    <parameter>
      <name>BATCH_ID</name>
      <default_value/>
      <description>Identificador único de lote</description>
    </parameter>
  </parameters>
  <actions>
    <action>
      <name>Start</name>
      <type>SPECIAL</type>
      <start>Y</start>
      <dummy>N</dummy>
      <repeat>N</repeat>
      <schedulerType>0</schedulerType>
      <parallel>N</parallel>
      <xloc>60</xloc>
      <yloc>100</yloc>
    </action>
    <action>
      <name>Extracción STG_UBICACIONES</name>
      <type>SQL</type>
      <sql>BEGIN
    stg_clinica_user.SP_EXTRACT_STG_UBICACIONES(
        p_tipo_carga =&gt; '${TIPO_CARGA}',
        p_batch_id   =&gt; '${BATCH_ID}'
    );
END;</sql>
      <useVariableSubstitution>Y</useVariableSubstitution>
      <sqlfromfile>N</sqlfromfile>
      <sendOneStatement>Y</sendOneStatement>
      <connection>Oracle_RedClinicas_DWH</connection>
      <parallel>N</parallel>
      <xloc>220</xloc>
      <yloc>100</yloc>
    </action>
